# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=embroidery_db

# Site Configuration
SITE_URL=http://localhost:8000
SITE_NAME=Embroidery File Manager
SITE_EMAIL=noreply@yoursite.com

# Security
SESSION_TIMEOUT=3600
BCRYPT_ROUNDS=10
ENCRYPTION_KEY=your_encryption_key_here

# File Upload
UPLOAD_DIR=/uploads/embroidery/
MAX_FILE_SIZE=1073741824
ALLOWED_EXTENSIONS=pes,dst,jef,exp,vip,vp3,xxx

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM=noreply@yoursite.com

# Environment
APP_ENV=production
APP_DEBUG=false
